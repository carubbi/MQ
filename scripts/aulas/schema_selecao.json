{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_selecao_aula.json",
  "title": "Manifesto privado de curadoria de aula",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_contrato",
    "estado",
    "aula",
    "notacao",
    "escopo",
    "planejamento_tempo",
    "ciclos",
    "topicos"
  ],
  "properties": {
    "versao_contrato": {"const": "1.3"},
    "estado": {"enum": ["em_selecao", "aprovado"]},
    "aula": {"$ref": "#/$defs/aula"},
    "notacao": {"$ref": "#/$defs/notacao"},
    "escopo": {"$ref": "#/$defs/escopo"},
    "planejamento_tempo": {"$ref": "#/$defs/planejamentoTempo"},
    "ciclos": {
      "type": "array",
      "items": {"$ref": "#/$defs/ciclo"}
    },
    "recursos_discentes": {"$ref": "#/$defs/recursosDiscentes"},
    "topicos": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/topico"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"estado": {"const": "aprovado"}},
        "required": ["estado"]
      },
      "then": {
        "required": ["recursos_discentes"],
        "properties": {"ciclos": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "texto": {"type": "string", "minLength": 1},
    "listaTextos": {
      "type": "array",
      "items": {"$ref": "#/$defs/texto"},
      "uniqueItems": true
    },
    "aula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semestre",
        "unidade",
        "numero",
        "data",
        "duracao_minutos",
        "titulo",
        "conteudos_formais",
        "resultado_aprendizagem"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^u[1-3]_a[0-9]{2}$"},
        "semestre": {"type": "string", "pattern": "^[0-9]{4}-[12]$"},
        "unidade": {"enum": ["I", "II", "III"]},
        "numero": {"type": "integer", "minimum": 1},
        "data": {"type": "string", "format": "date"},
        "duracao_minutos": {"type": "integer", "const": 100},
        "titulo": {"$ref": "#/$defs/texto"},
        "conteudos_formais": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$"},
          "uniqueItems": true
        },
        "resultado_aprendizagem": {"$ref": "#/$defs/texto"}
      }
    },
    "notacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convencao", "caminho"],
      "properties": {
        "convencao": {"const": "global"},
        "caminho": {"const": ".interno/docs/modelos/notacao-estatistica.md"}
      }
    },
    "escopo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incluidos", "excluidos", "reservados"],
      "properties": {
        "incluidos": {"$ref": "#/$defs/listaTextos"},
        "excluidos": {"$ref": "#/$defs/listaTextos"},
        "reservados": {"$ref": "#/$defs/listaTextos"}
      }
    },
    "planejamentoTempo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abertura_minutos", "fechamento_minutos"],
      "properties": {
        "abertura_minutos": {"type": "integer", "minimum": 0},
        "fechamento_minutos": {"type": "integer", "minimum": 0}
      }
    },
    "ciclo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titulo",
        "topicos",
        "complexidade",
        "duracao_minima_minutos",
        "justificativa_particao",
        "aplicacao_notebook",
        "atividade_resolvida"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ciclo-[0-9]{2}$"},
        "titulo": {"$ref": "#/$defs/texto"},
        "topicos": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/texto"},
          "uniqueItems": true
        },
        "complexidade": {"enum": ["baixa", "moderada", "alta"]},
        "duracao_minima_minutos": {"type": "integer", "minimum": 1},
        "justificativa_particao": {"$ref": "#/$defs/texto"},
        "aplicacao_notebook": {"$ref": "#/$defs/aplicacaoNotebook"},
        "atividade_resolvida": {"$ref": "#/$defs/atividadeResolvida"}
      }
    },
    "aplicacaoNotebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objetivo",
        "pergunta",
        "contraste",
        "evidencia",
        "ciclo_notebook",
        "caminho"
      ],
      "properties": {
        "objetivo": {"$ref": "#/$defs/texto"},
        "pergunta": {"$ref": "#/$defs/texto"},
        "contraste": {"$ref": "#/$defs/texto"},
        "evidencia": {"$ref": "#/$defs/texto"},
        "ciclo_notebook": {"type": "string", "pattern": "^ciclo-[0-9]{2}$"},
        "caminho": {"$ref": "#/$defs/texto"}
      }
    },
    "atividadeResolvida": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencia_id",
        "tipo_origem",
        "descricao_item",
        "paginas_pdf",
        "forma_uso",
        "conceitos_aplicados",
        "justificativa_excecao"
      ],
      "properties": {
        "referencia_id": {"$ref": "#/$defs/texto"},
        "tipo_origem": {
          "enum": ["exercicio", "questao", "exemplo_aplicado"]
        },
        "descricao_item": {"$ref": "#/$defs/texto"},
        "paginas_pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inicio", "fim"],
          "properties": {
            "inicio": {"type": "integer", "minimum": 1},
            "fim": {"type": "integer", "minimum": 1}
          }
        },
        "forma_uso": {"enum": ["parafraseado", "adaptado"]},
        "conceitos_aplicados": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/texto"},
          "uniqueItems": true
        },
        "justificativa_excecao": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"tipo_origem": {"const": "exemplo_aplicado"}},
            "required": ["tipo_origem"]
          },
          "then": {
            "properties": {"justificativa_excecao": {"$ref": "#/$defs/texto"}}
          },
          "else": {
            "properties": {"justificativa_excecao": {"type": "null"}}
          }
        }
      ]
    },
    "recursoDiscente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/texto"}
      }
    },
    "recursosDiscentes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materiais_didaticos", "exercicios_indicados"],
      "properties": {
        "materiais_didaticos": {
          "type": "array",
          "items": {"$ref": "#/$defs/recursoDiscente"},
          "uniqueItems": true
        },
        "exercicios_indicados": {
          "type": "array",
          "items": {"$ref": "#/$defs/recursoDiscente"},
          "uniqueItems": true
        }
      }
    },
    "topico": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "classificacao",
        "subassuntos",
        "estado",
        "divergencias",
        "compatibilizacao",
        "profundidade",
        "referencias"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^topico-[a-z0-9-]+$"},
        "nome": {"$ref": "#/$defs/texto"},
        "classificacao": {
          "enum": ["central", "prerequisito", "opcional", "adiado"]
        },
        "subassuntos": {"$ref": "#/$defs/listaTextos"},
        "estado": {
          "enum": ["pendente", "selecionado", "rejeitado", "adiado"]
        },
        "divergencias": {"$ref": "#/$defs/listaTextos"},
        "compatibilizacao": {"$ref": "#/$defs/compatibilizacao"},
        "profundidade": {"const": "formal_aplicada"},
        "referencias": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/referencia"}
        }
      }
    },
    "compatibilizacao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convencao", "observacao"],
      "properties": {
        "convencao": {"enum": ["notacao_global", "excecao"]},
        "observacao": {"$ref": "#/$defs/texto"}
      }
    },
    "referencia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fonte_id",
        "estado",
        "papeis",
        "paginas_pdf",
        "cobertura",
        "notacao"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/texto"},
        "fonte_id": {"$ref": "#/$defs/texto"},
        "estado": {"enum": ["pendente", "selecionada", "rejeitada"]},
        "papeis": {
          "type": "array",
          "items": {
            "enum": [
              "fundamentacao",
              "complementar",
              "contraponto",
              "exemplo",
              "exercicio"
            ]
          },
          "uniqueItems": true
        },
        "paginas_pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inicio", "fim"],
          "properties": {
            "inicio": {"type": "integer", "minimum": 1},
            "fim": {"type": "integer", "minimum": 1}
          }
        },
        "cobertura": {"$ref": "#/$defs/texto"},
        "notacao": {"$ref": "#/$defs/texto"}
      }
    }
  }
}
